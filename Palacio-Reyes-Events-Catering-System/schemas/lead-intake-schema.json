{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://palacioreyesevents.com/schemas/lead-intake.json",
  "title": "Lead Intake Form",
  "description": "Schema for Palacio Reyes Events & Catering lead intake form data validation",
  "type": "object",
  "required": [
    "eventDate",
    "venue",
    "headcountMin",
    "headcountTarget",
    "eventType",
    "contactName",
    "contactEmail",
    "contactPhone",
    "priority1",
    "priority2"
  ],
  "properties": {
    "eventID": {
      "type": "string",
      "pattern": "^PR-\\d{8}-[A-Z0-9]{6}$",
      "description": "Auto-generated unique event identifier (format: PR-YYYYMMDD-XXXXXX)"
    },
    "submissionDate": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of form submission"
    },
    "eventBasics": {
      "type": "object",
      "properties": {
        "eventDate": {
          "type": "string",
          "format": "date",
          "description": "Preferred event date"
        },
        "eventTime": {
          "type": "string",
          "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Preferred start time in HH:MM format"
        },
        "eventDuration": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 24,
          "multipleOf": 0.5,
          "description": "Estimated duration in hours"
        },
        "dateFlexible": {
          "type": "string",
          "enum": ["fixed", "slightly", "flexible", "very-flexible"],
          "description": "Level of date/time flexibility"
        },
        "alternateDates": {
          "type": "string",
          "description": "List of alternate acceptable dates"
        },
        "venue": {
          "type": "string",
          "minLength": 3,
          "description": "Venue name or address"
        },
        "venueType": {
          "type": "string",
          "enum": [
            "client-office",
            "hotel-conference",
            "outdoor",
            "restaurant",
            "residence",
            "event-space",
            "other"
          ],
          "description": "Type of venue"
        },
        "accessWindows": {
          "type": "string",
          "description": "Load-in and access time windows"
        },
        "onSiteContact": {
          "type": "string",
          "description": "On-site contact person name"
        }
      }
    },
    "headcountBudget": {
      "type": "object",
      "properties": {
        "headcountMin": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum guest count"
        },
        "headcountTarget": {
          "type": "integer",
          "minimum": 1,
          "description": "Target guest count"
        },
        "headcountMax": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum guest count"
        },
        "headcountFlexible": {
          "type": "string",
          "enum": ["fixed", "slight", "moderate", "uncertain"],
          "description": "Headcount flexibility level"
        },
        "budgetPerGuest": {
          "type": "number",
          "minimum": 0,
          "description": "Budget per guest in dollars"
        },
        "budgetTotal": {
          "type": "string",
          "description": "Total budget range (free-form)"
        },
        "budgetFlexible": {
          "type": "string",
          "enum": ["firm", "slight", "flexible", "no-budget"],
          "description": "Budget flexibility level"
        }
      }
    },
    "eventTypeService": {
      "type": "object",
      "properties": {
        "eventType": {
          "type": "string",
          "enum": [
            "corporate",
            "non-profit",
            "private",
            "brand-activation",
            "wedding",
            "other"
          ],
          "description": "Primary event category"
        },
        "eventDescription": {
          "type": "string",
          "description": "Detailed event description and purpose"
        },
        "serviceStyle": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "buffet",
              "stations",
              "plated",
              "passed",
              "bar",
              "family-style"
            ]
          },
          "uniqueItems": true,
          "description": "Preferred service styles (multiple allowed)"
        }
      }
    },
    "contactBilling": {
      "type": "object",
      "properties": {
        "contactName": {
          "type": "string",
          "minLength": 2,
          "description": "Primary contact full name"
        },
        "contactTitle": {
          "type": "string",
          "description": "Contact's job title or role"
        },
        "contactEmail": {
          "type": "string",
          "format": "email",
          "description": "Contact email address"
        },
        "contactPhone": {
          "type": "string",
          "pattern": "^[\\d\\s\\-\\(\\)\\+\\.]+$",
          "minLength": 10,
          "description": "Contact phone number"
        },
        "companyName": {
          "type": "string",
          "description": "Company or organization name"
        },
        "billingEntity": {
          "type": "string",
          "description": "Billing entity if different from company"
        },
        "corporateSponsor": {
          "type": "string",
          "description": "Corporate or fiscal sponsor information"
        },
        "decisionMaker": {
          "type": "string",
          "description": "Final decision maker if different from contact"
        }
      }
    },
    "priorities": {
      "type": "object",
      "properties": {
        "priority1": {
          "type": "string",
          "minLength": 3,
          "description": "Top non-negotiable priority"
        },
        "priority2": {
          "type": "string",
          "minLength": 3,
          "description": "Second non-negotiable priority"
        },
        "dietaryRestrictions": {
          "type": "string",
          "description": "Known dietary restrictions and allergies"
        },
        "allergyCoordinator": {
          "type": "string",
          "description": "Person responsible for coordinating allergy information"
        },
        "specialRequests": {
          "type": "string",
          "description": "Additional special requests or considerations"
        }
      }
    },
    "internalAssessment": {
      "type": "object",
      "description": "Internal use only - staff assessment fields",
      "properties": {
        "riskRating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "Payment/chargeback risk rating (1=low, 2=medium, 3=high)"
        },
        "venueComplexity": {
          "type": "string",
          "description": "Venue complexity and logistics notes"
        },
        "riskFlags": {
          "type": "string",
          "description": "Additional risk flags or concerns"
        }
      }
    },
    "marketing": {
      "type": "object",
      "properties": {
        "marketingSource": {
          "type": "string",
          "enum": [
            "referral",
            "venue",
            "past-client",
            "website",
            "social",
            "advertisement",
            "other"
          ],
          "description": "How the client heard about us"
        },
        "referralDetails": {
          "type": "string",
          "description": "Specific referral source details"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "System metadata",
      "properties": {
        "formVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "default": "1.0.0",
          "description": "Lead intake form version"
        },
        "createdBy": {
          "type": "string",
          "description": "User or system that created the lead"
        },
        "lastModified": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "submitted",
            "qualified",
            "quoted",
            "contracted",
            "declined"
          ],
          "default": "submitted",
          "description": "Lead processing status"
        },
        "assignedTo": {
          "type": "string",
          "description": "Sales team member assigned to this lead"
        }
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "eventID": "PR-20250315-A7B9C2",
      "submissionDate": "2025-03-15T10:30:00Z",
      "eventBasics": {
        "eventDate": "2025-04-20",
        "eventTime": "18:00",
        "eventDuration": 4,
        "dateFlexible": "slightly",
        "venue": "Downtown Convention Center",
        "venueType": "hotel-conference",
        "accessWindows": "3 hours before event",
        "onSiteContact": "Sarah Johnson"
      },
      "headcountBudget": {
        "headcountMin": 75,
        "headcountTarget": 100,
        "headcountMax": 125,
        "headcountFlexible": "slight",
        "budgetPerGuest": 65,
        "budgetTotal": "$6,000 - $8,000",
        "budgetFlexible": "slight"
      },
      "eventTypeService": {
        "eventType": "corporate",
        "eventDescription": "Annual company awards dinner with networking reception",
        "serviceStyle": ["passed", "plated", "bar"]
      },
      "contactBilling": {
        "contactName": "Michael Chen",
        "contactTitle": "Events Manager",
        "contactEmail": "m.chen@techcorp.com",
        "contactPhone": "(555) 123-4567",
        "companyName": "TechCorp Industries",
        "billingEntity": "TechCorp Industries"
      },
      "priorities": {
        "priority1": "Professional presentation for executive guests",
        "priority2": "Seamless service timing - event must end by 10pm",
        "dietaryRestrictions": "Approximately 15% vegetarian, 3 gluten-free, 2 shellfish allergies",
        "allergyCoordinator": "Michael Chen"
      },
      "internalAssessment": {
        "riskRating": 1,
        "venueComplexity": "Established venue with good utilities; loading dock available"
      },
      "marketing": {
        "marketingSource": "venue",
        "referralDetails": "Convention center recommended us"
      },
      "metadata": {
        "formVersion": "1.0.0",
        "status": "submitted",
        "assignedTo": "Sales Team"
      }
    }
  ]
}
