{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://homeops.ai/schemas/vendor.json",
  "title": "Vendor",
  "description": "A service provider or vendor",
  "type": "object",
  "required": ["id", "name", "category", "contactInfo"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^vendor-[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "cleaning",
        "landscaping",
        "pool",
        "hvac",
        "plumbing",
        "electrical",
        "handyman",
        "pest_control",
        "security",
        "contractor",
        "other"
      ]
    },
    "contactInfo": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "company": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "website": { "type": "string", "format": "uri" }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of services provided"
    },
    "rate": {
      "type": "object",
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "default": "USD" },
        "frequency": { "type": "string" },
        "unit": { "type": "string" }
      }
    },
    "schedule": {
      "type": "object",
      "properties": {
        "frequency": {
          "type": "string",
          "enum": ["weekly", "biweekly", "monthly", "quarterly", "annual", "as_needed"]
        },
        "preferredDay": { "type": "string" },
        "preferredTime": { "type": "string" },
        "lastVisit": { "type": "string", "format": "date" },
        "nextVisit": { "type": "string", "format": "date" }
      }
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "content": { "type": "string" }
        }
      }
    },
    "serviceHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "service": { "type": "string" },
          "cost": { "type": "number" },
          "notes": { "type": "string" },
          "rating": { "type": "number" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["Active", "Inactive", "Archived"],
      "default": "Active"
    },
    "preferredContact": {
      "type": "string",
      "enum": ["phone", "email", "text", "app"]
    },
    "insurance": {
      "type": "object",
      "properties": {
        "hasInsurance": { "type": "boolean" },
        "policyNumber": { "type": "string" },
        "expirationDate": { "type": "string", "format": "date" }
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "hasLicense": { "type": "boolean" },
        "licenseNumber": { "type": "string" },
        "expirationDate": { "type": "string", "format": "date" }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
