{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://homeops.ai/schemas/event.json",
  "title": "Event",
  "description": "A calendar event or appointment",
  "type": "object",
  "required": ["id", "title", "type", "dateTime", "owner"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^event-[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "School",
        "Activity",
        "Social",
        "Medical",
        "Travel",
        "Home",
        "Business",
        "Personal"
      ]
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "description": "Start date and time (ISO 8601)"
    },
    "endDateTime": {
      "type": "string",
      "format": "date-time",
      "description": "End date and time (ISO 8601)"
    },
    "duration": {
      "type": "integer",
      "minimum": 0,
      "description": "Duration in minutes"
    },
    "allDay": {
      "type": "boolean",
      "default": false
    },
    "location": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "instructions": { "type": "string" }
      }
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^person-[a-z0-9-]+$"
      },
      "description": "Person IDs of attendees"
    },
    "owner": {
      "type": "string",
      "enum": ["Luke", "Lucy", "Kids", "Family"],
      "description": "Primary responsible party"
    },
    "priority": {
      "type": "string",
      "enum": ["Critical", "High", "Medium", "Low"],
      "default": "Medium"
    },
    "requiresPrep": {
      "type": "boolean",
      "description": "Whether prep tasks are needed"
    },
    "prepTasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^task-[a-z0-9-]+$"
      },
      "description": "Task IDs for preparation"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^event-[a-z0-9-]+$"
      },
      "description": "Event IDs of conflicting events"
    },
    "status": {
      "type": "string",
      "enum": ["Tentative", "Confirmed", "Cancelled", "Completed"],
      "default": "Tentative"
    },
    "rsvpRequired": {
      "type": "boolean"
    },
    "rsvpDeadline": {
      "type": "string",
      "format": "date"
    },
    "rsvpStatus": {
      "type": "string",
      "enum": ["Pending", "Yes", "No", "Maybe"]
    },
    "reminders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": { "type": "integer", "description": "Minutes before event" },
          "method": { "type": "string", "enum": ["email", "sms", "notification"] }
        }
      }
    },
    "recurrence": {
      "type": "object",
      "properties": {
        "frequency": {
          "type": "string",
          "enum": ["daily", "weekly", "biweekly", "monthly", "yearly"]
        },
        "interval": { "type": "integer", "minimum": 1 },
        "endDate": { "type": "string", "format": "date" },
        "exceptions": {
          "type": "array",
          "items": { "type": "string", "format": "date" }
        }
      }
    },
    "cost": {
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "paid": { "type": "boolean" }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "content": { "type": "string" }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
