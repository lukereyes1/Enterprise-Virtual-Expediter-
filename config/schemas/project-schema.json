{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://homeops.ai/schemas/project.json",
  "title": "Project",
  "description": "A multi-task project or initiative",
  "type": "object",
  "required": ["id", "name", "category", "status", "owner"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^project-[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": ["Home", "Kids", "Personal", "Business", "Family"]
    },
    "status": {
      "type": "string",
      "enum": ["Planning", "In Progress", "On Hold", "Completed", "Cancelled"],
      "default": "Planning"
    },
    "owner": {
      "type": "string",
      "enum": ["Luke", "Lucy", "Joint", "AI", "HumanAssistant"]
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "targetEndDate": {
      "type": "string",
      "format": "date"
    },
    "actualEndDate": {
      "type": "string",
      "format": "date"
    },
    "priority": {
      "type": "string",
      "enum": ["Critical", "High", "Medium", "Low"],
      "default": "Medium"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^task-[a-z0-9-]+$"
      },
      "description": "Task IDs associated with this project"
    },
    "vendors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^vendor-[a-z0-9-]+$"
      },
      "description": "Vendor IDs involved in this project"
    },
    "budget": {
      "type": "object",
      "properties": {
        "estimated": {
          "type": "number",
          "minimum": 0
        },
        "actual": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "default": "USD"
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "dueDate": { "type": "string", "format": "date" },
          "completed": { "type": "boolean" },
          "completedDate": { "type": "string", "format": "date" }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "type": { "type": "string" }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "author": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
